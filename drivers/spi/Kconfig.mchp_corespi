config SPI_MCHP_CORESPI
	bool "Microchip Polarfire SOC Core SPI driver"
	default y
	depends on DT_HAS_MICROCHIP_MPFS_SPI_ENABLED
	help
	  Enable support for the Microchip FPGA CoreSPI driver.
